{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "affinity",
    "labels": {
      "app": "affinity"
    }
  },
  "spec": {
    "terminationGracePeriodSeconds": 2,
    "containers": [
      {
        "name": "app",
        "image": "python:3.12-alpine",
        "imagePullPolicy": "IfNotPresent",
        "command": [
          "python",
          "-u",
          "-c",
          "import time; time.sleep(3600)"
        ]
      }
    ],
    "nodeSelector": {
      "lab.example.com/zone": "missing"
    }
  }
}
