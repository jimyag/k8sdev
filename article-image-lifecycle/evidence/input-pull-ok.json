{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "pull-ok",
    "labels": {
      "app": "pull-ok"
    }
  },
  "spec": {
    "containers": [
      {
        "name": "app",
        "image": "alpine:3.20",
        "imagePullPolicy": "Always",
        "command": [
          "sh",
          "-c",
          "sleep 3600"
        ]
      }
    ]
  }
}
