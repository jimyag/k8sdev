{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "writer",
    "labels": {
      "app": "writer"
    }
  },
  "spec": {
    "terminationGracePeriodSeconds": 1,
    "nodeSelector": {
      "kubernetes.io/hostname": "article-next-worker2"
    },
    "containers": [
      {
        "name": "app",
        "image": "alpine:3.20",
        "imagePullPolicy": "IfNotPresent",
        "command": [
          "sh",
          "-c",
          "sleep 3600"
        ],
        "volumeMounts": [
          {
            "name": "data",
            "mountPath": "/data"
          }
        ]
      }
    ],
    "volumes": [
      {
        "name": "data",
        "persistentVolumeClaim": {
          "claimName": "expand"
        }
      }
    ]
  }
}
