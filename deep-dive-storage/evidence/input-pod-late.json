{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "late",
    "labels": {
      "app": "late"
    }
  },
  "spec": {
    "terminationGracePeriodSeconds": 2,
    "containers": [
      {
        "name": "app",
        "image": "python:3.12-alpine",
        "imagePullPolicy": "IfNotPresent",
        "command": [
          "python",
          "-u",
          "-c",
          "import time; time.sleep(3600)"
        ],
        "volumeMounts": [
          {
            "name": "data",
            "mountPath": "/data"
          }
        ]
      }
    ],
    "nodeSelector": {
      "kubernetes.io/hostname": "deep-dive-worker2"
    },
    "volumes": [
      {
        "name": "data",
        "persistentVolumeClaim": {
          "claimName": "late"
        }
      }
    ]
  }
}
