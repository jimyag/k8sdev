{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "after",
    "labels": {
      "app": "after"
    }
  },
  "spec": {
    "terminationGracePeriodSeconds": 1,
    "containers": [
      {
        "name": "app",
        "image": "alpine:3.20",
        "imagePullPolicy": "IfNotPresent",
        "command": [
          "sh",
          "-c",
          "sleep 3600"
        ]
      }
    ]
  }
}
