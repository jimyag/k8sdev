{
  "apiVersion": "batch/v1",
  "kind": "Job",
  "metadata": {
    "name": "indexed",
    "labels": {
      "app": "indexed"
    }
  },
  "spec": {
    "template": {
      "metadata": {
        "labels": {
          "app": "indexed"
        }
      },
      "spec": {
        "restartPolicy": "Never",
        "containers": [
          {
            "name": "task",
            "image": "alpine:3.20",
            "imagePullPolicy": "IfNotPresent",
            "command": [
              "sh",
              "-c",
              "echo \"completion=${JOB_COMPLETION_INDEX}\"; sleep 1"
            ]
          }
        ]
      }
    },
    "completions": 4,
    "parallelism": 2,
    "completionMode": "Indexed",
    "backoffLimit": 0
  }
}
